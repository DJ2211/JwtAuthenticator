{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DatabaseProvider": "sqlite",
  "ConnectionStrings": {
    "Sqlite": "Data Source=jwtauthenticator.db",
    "Postgres": "Host=localhost;Port=5432;Database=JwtAuthDb;Username=postgres;Password=your_password",
    "SqlServer": "Server=localhost;Database=JwtAuthDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "JwtSettings": {
    "SecretKey": "super_secret_key_minimum_32_characters_long_for_hmac_sha256!",
    "Issuer": "JwtAuthenticator",
    "Audience": "JwtAuthenticatorClient",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7,
    "UseHttpOnlyRefreshCookie": false,
    "RefreshCookieName":  "refreshToken"
  },

  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:4200"
    ]
  },

  "SeedAdmin": {
    "Email": "admin@jwtauthenticator.local",
    "Password": "Admin@Password123!"
  },
  "EmailSettings": {
    "Provider": "console",
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "FromEmail": "noreply@jwtauthenticator.local",
    "FromName": "JwtAuthenticator",
    "Username": "",
    "Password": "",
    "UseSsl": false
  },
  "Authentication": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "Github": {
      "ClientId": "",
      "ClientSecret":  ""
    }
  }
}
